# CRM Patent Analyzer - Configuration
# Copy this file to .env and fill in your API keys

# SerpApi Key (primary patent search source)
# Get a free key at: https://serpapi.com/
SERPAPI_KEY=

# Lens.org API Key (alternative patent search source)
# Register at: https://www.lens.org/lens/user/subscriptions
LENS_API_KEY=

# Web Server Settings
CRM_WEB_HOST=0.0.0.0
CRM_WEB_PORT=8050
CRM_WEB_DEBUG=false

# Scheduler Settings
CRM_SCAN_INTERVAL_DAYS=30
CRM_SCAN_CRON_HOUR=2
